# VirusTotal
VT_API_KEY=replace-with-your-api-key
VT_DOMAINS=your-domain.eu,project-gitlab.com,example.org
VT_ALERT_LOG=logs/alerts.jsonl

# The program enforces a minimum of 60 seconds between domain submissions.
VT_DOMAIN_DELAY_SECONDS=60
VT_POLL_INTERVAL_SECONDS=30
VT_ANALYSIS_TIMEOUT_SECONDS=900
VT_HTTP_TIMEOUT_SECONDS=30
VT_MAX_HTTP_RETRIES=4

# SMTP (leave both authentication values empty for an unauthenticated relay)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=monitor@example.org
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM=monitor@example.org
SMTP_RECIPIENTS=security@example.org,admin@example.org
